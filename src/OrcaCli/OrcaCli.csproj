<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Must match the 32-bit pborc.dll. -->
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>orca-cli</AssemblyName>
    <RootNamespace>OrcaCli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <AssemblyTitle>orca-cli</AssemblyTitle>
    <Description>Command line front end for Appeon PowerBuilder ORCA (pborc.dll).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orca\Orca.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
